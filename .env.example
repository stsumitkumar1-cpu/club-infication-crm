# Club Infication CRM — backend environment
#
# Copy this file to .env and fill in real values. .env is gitignored and must
# never be committed (Master Spec 16). The app validates these at startup and
# refuses to boot if a required one is missing or a secret is too weak.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/club_infication_crm?schema=public"

# Optional mirror database kept in sync with the primary.
# Apply schema changes with `npm run migrate:all`, never a bare migrate deploy.
DATABASE_URL_MIRROR="postgresql://USER:PASSWORD@localhost:5434/club_infication_crm?schema=public"

# ---------------------------------------------------------------------------
# Auth secrets — REQUIRED, minimum 32 characters each.
# There is deliberately no default: a known signing key lets anyone forge a
# Super Admin token. Generate each one separately with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Rotating either value invalidates all tokens already issued.
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes (optional; these are the defaults).
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# ---------------------------------------------------------------------------
# First Super Admin — BOOTSTRAP INPUT ONLY, read once by `npm run seed`.
#
# The database stores only a bcrypt hash, so it is the single source of truth
# for the current password. Blank SEED_ADMIN_PASSWORD once the admin exists:
# leaving it here keeps a plaintext credential on disk and it goes stale the
# moment the password changes.
#
# Rotate later without touching this file:
#   npm run admin:reset-password -- --password 'NewPass123'
#
# Re-running the seed will NOT overwrite an existing admin's password.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Super Admin

# ---------------------------------------------------------------------------
# Email notifications (Spec 14). OFF by default: the template and whether the
# email is mandatory are pending client confirmation (Spec 22 #7), and no
# transport is wired yet. With this false, messages are logged, never sent.
# ---------------------------------------------------------------------------
NOTIFICATIONS_ENABLED=false

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
